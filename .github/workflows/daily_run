name: Daily SRP Update Job

on:
  schedule:
    - cron: '0 1 * * *'  # 每天 UTC 01:00 (台灣時間早上 9:00) 自動執行
  workflow_dispatch:      # 允許你在 GitHub 介面手動點擊按鈕執行測試

jobs:
  scrape-and-update:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.9'

      - name: Install Dependencies
        run: |
          pip install playwright pandas lxml openai requests
          playwright install chromium

      - name: Run Script
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: python cloud_track_v26.py
